# =============================================================================
# College Quiz & Anonymous Feedback Portal - Environment Configuration Example
# Copy to .env and replace placeholder values. NEVER commit real secrets to git.
# =============================================================================

# --- Backend Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
# For local testing without configuring MySQL credentials yet, set:
# SPRING_PROFILES_ACTIVE=demo

# --- MySQL 8.0 Database ---
DB_URL=jdbc:mysql://localhost:3306/college_quiz_portal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD

# --- Security Secrets (generate strong 64+ char random values in production) ---
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_CHAR_RANDOM_SECRET_KEY
JWT_EXPIRATION_MS=28800000
TOKEN_PEPPER=REPLACE_WITH_STRONG_RANDOM_PEPPER_FOR_TOKEN_HASHING
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# --- Initial Seed Accounts (used only when users table is empty) ---
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
SEED_STAFF_EMAIL=staff@college.edu
SEED_STAFF_PASSWORD=REPLACE_WITH_INITIAL_STAFF_PASSWORD

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
